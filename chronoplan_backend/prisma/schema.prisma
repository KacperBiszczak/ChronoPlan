generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  avatarUrl String?
  phone     String?
  bio       String?

  events Event[]
  tasks  Task[]

  eventParticipants EventParticipant[]
  dateVotes         DateVote[]

  paidExpenses         Expense[]    @relation("ExpensePayer")
  settlementsToPay     Settlement[] @relation("SettlementFrom")
  settlementsToReceive Settlement[] @relation("SettlementTo")

  chatMessages             ChatMessage[]
  googleCalendarConnection GoogleCalendarConnection?
  googleCalendarEventSyncs GoogleCalendarEventSync[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime

  budgetMode BudgetMode @default(SHARED)

  dateOptions DateOption[]

  locationName    String?
  locationAddress String?
  latitude        Float?
  longitude       Float?

  googleCalendarSyncs GoogleCalendarEventSync[]

  creatorId Int
  creator   User @relation(fields: [creatorId], references: [id])

  tasks       Task[]
  expenses    Expense[]
  settlements Settlement[]

  chatMessages ChatMessage[]

  participants EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  assigneeId Int?
  assignee   User? @relation(fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id     Int    @id @default(autoincrement())
  title  String
  amount Float

  category       String?
  visibility     ExpenseVisibility     @default(PARTICIPANTS)
  settlementType ExpenseSettlementType @default(SPLIT_EQUALLY)

  eventId Int
  event   Event @relation(fields: [eventId], references: [id])

  paidById Int?
  paidBy   User? @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settlement {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  fromUserId Int
  fromUser   User @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId Int
  toUser   User @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)

  amount Float
  status SettlementStatus @default(PENDING)

  paidAt      DateTime?
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, fromUserId, toUserId])
  @@index([eventId])
  @@index([fromUserId])
  @@index([toUserId])
}

model EventParticipant {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   EventRole         @default(PARTICIPANT)
  status ParticipantStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model DateOption {
  id           Int      @id @default(autoincrement())
  proposedDate DateTime

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  votes DateVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DateVote {
  id     Int            @id @default(autoincrement())
  status DateVoteStatus

  optionId Int
  option   DateOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([optionId, userId])
}

model ChatMessage {
  id      Int    @id @default(autoincrement())
  content String

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleCalendarConnection {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  scope        String?
  tokenType    String?
  expiryDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleCalendarEventSync {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleCalendarEventId String
  syncedAt              DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

enum DateVoteStatus {
  YES
  MAYBE
  NO
}

enum EventRole {
  ORGANIZER
  PARTICIPANT
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum BudgetMode {
  PRIVATE
  SHARED
  MIXED
}

enum ExpenseVisibility {
  ORGANIZER_ONLY
  PARTICIPANTS
}

enum ExpenseSettlementType {
  NONE
  SPLIT_EQUALLY
}

enum SettlementStatus {
  PENDING
  MARKED_AS_PAID
  CONFIRMED
  CANCELLED
}
